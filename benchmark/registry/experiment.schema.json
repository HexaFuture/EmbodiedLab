{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "embodiedlab/registry/experiment.schema.json",
  "title": "EmbodiedLab experiment specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "tier", "kit", "title", "task_card", "scene",
               "hidden", "constraints", "instruments", "budget", "submission", "gates", "scoring"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"type": "integer", "minimum": 1},
    "tier": {"enum": ["basic", "advanced"]},
    "kit": {"enum": ["mechanics", "circuits", "chemistry", "optics", "thermal"]},
    "title": {"type": "string", "minLength": 1},
    "task_card": {"type": "string", "pattern": "\\.md$"},
    "scene": {
      "type": "object", "additionalProperties": false, "required": ["recipe", "params"],
      "properties": {
        "recipe": {"type": "string"},
        "params": {"type": "object"},
        "layout_jitter": {
          "type": "object", "additionalProperties": false, "required": ["xy_m", "yaw_deg"],
          "properties": {"xy_m": {"type": "number", "minimum": 0}, "yaw_deg": {"type": "number", "minimum": 0}}
        }
      }
    },
    "hidden": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/distribution"}
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "instruments": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "affordances": {"type": "array", "items": {"type": "string"}},
    "consumables": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "budget": {
      "type": "object", "additionalProperties": false, "required": ["sim_s", "wall_s"],
      "properties": {
        "sim_s": {"type": "number", "exclusiveMinimum": 0},
        "wall_s": {"type": "number", "exclusiveMinimum": 0},
        "submissions": {"const": 1}
      }
    },
    "submission": {
      "type": "object", "additionalProperties": false, "required": ["schema", "primary"],
      "properties": {
        "schema": {"type": "string", "pattern": "\\.json$"},
        "primary": {"type": "object", "additionalProperties": false, "required": ["field", "unit"],
                    "properties": {"field": {"type": "string"}, "unit": {"type": "string"}}}
      }
    },
    "gates": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          {"type": "string"},
          {"type": "object", "minProperties": 1, "maxProperties": 1,
           "additionalProperties": {"type": "object"}}
        ]
      }
    },
    "scoring": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "target", "threshold", "reward"],
      "properties": {
        "metric": {"enum": ["rel_error", "sealed_rel_error", "abs_error", "max_rel_error", "exact", "composite"]},
        "target": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}, "minItems": 1}]},
        "field": {"type": "string"},
        "fields": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "threshold": {"type": "number", "exclusiveMinimum": 0},
        "reward": {"const": "G * max(0, 1 - e)"},
        "diagnostics": {"type": "array", "items": {"type": "string"}},
        "components": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["field", "target", "metric", "threshold"],
          "properties": {"field": {"type": "string"}, "target": {"type": "string"},
                         "metric": {"enum": ["abs_error", "rel_error"]},
                         "threshold": {"type": "number", "exclusiveMinimum": 0}}
        }}
      },
      "allOf": [{"if": {"properties": {"metric": {"const": "composite"}}},
                 "then": {"required": ["components"], "properties": {"threshold": {"const": 1.0}}},
                 "else": {"not": {"required": ["components"]}}}]
    },
    "hooks": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "derive": {"type": ["null", "string"]},
        "evaluator_extra": {"type": ["null", "string"]}
      }
    }
  },
  "$defs": {
    "number_or_expr": {"oneOf": [{"type": "number"}, {"type": "string"}]},
    "distribution": {
      "type": "object", "required": ["dist"],
      "properties": {"public": {"type": "boolean"}},
      "oneOf": [
        {"properties": {"dist": {"const": "choice"}, "values": {"type": "array", "minItems": 1}, "public": {}},
         "required": ["values"], "additionalProperties": false},
        {"properties": {"dist": {"enum": ["uniform", "loguniform"]},
                        "low": {"$ref": "#/$defs/number_or_expr"}, "high": {"$ref": "#/$defs/number_or_expr"}, "public": {}},
         "required": ["low", "high"], "additionalProperties": false},
        {"properties": {"dist": {"const": "int_uniform"},
                        "low": {"$ref": "#/$defs/number_or_expr"}, "high": {"$ref": "#/$defs/number_or_expr"}, "public": {}},
         "required": ["low", "high"], "additionalProperties": false},
        {"properties": {"dist": {"const": "derived"}, "expr": {"type": "string"}, "public": {}},
         "required": ["expr"], "additionalProperties": false}
      ]
    }
  }
}
