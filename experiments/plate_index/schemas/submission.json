{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "embodiedlab/experiments/plate_index/submission.json",
  "title": "plate_index submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["n", "no_plate", "plate", "model", "uncertainty_statement"],
  "properties": {
    "n": {"type": "number", "exclusiveMinimum": 1},
    "no_plate": {"$ref": "#/$defs/group"},
    "plate": {"$ref": "#/$defs/group"},
    "model": {"type": "string", "minLength": 1, "maxLength": 4000},
    "uncertainty_statement": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "$defs": {
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["measurements"],
      "properties": {
        "measurements": {
          "type": "array", "minItems": 1, "maxItems": 30,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["evidence_id", "lens_mm", "screen_mm"],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 1, "maxLength": 200},
              "lens_mm": {"type": "number"},
              "screen_mm": {"type": "number"}
            }
          }
        }
      }
    }
  },
  "examples": [{
    "n": "<n, a number>",
    "no_plate": {"measurements": [{"evidence_id": "<episode_id>:obs:<n>", "lens_mm": "<lens position in mm, a number>", "screen_mm": "<screen position in mm, a number>"}]},
    "plate": {"measurements": [{"evidence_id": "<episode_id>:obs:<n>", "lens_mm": "<lens position in mm, a number>", "screen_mm": "<screen position in mm, a number>"}]},
    "model": "<the relation you used and how each submitted value follows from the cited evidence>",
    "uncertainty_statement": "<your uncertainty estimate and its main contributions>"
  }]
}
