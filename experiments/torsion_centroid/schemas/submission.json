{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "embodiedlab/experiments/torsion_centroid/submission.json",
  "title": "torsion_centroid submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "I_com_kgm2",
    "x_com_m",
    "unit",
    "position_unit",
    "model",
    "measurements",
    "uncertainty_statement"
  ],
  "properties": {
    "unit": {
      "const": "kg m^2"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "load",
          "period_s",
          "used_in_fit",
          "hole"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "load": {
            "enum": [
              "empty",
              "standard_disc",
              "unknown_object"
            ]
          },
          "period_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "n_periods": {
            "type": "integer",
            "minimum": 1
          },
          "used_in_fit": {
            "type": "boolean"
          },
          "hole": {
            "type": ["integer", "null"],
            "minimum": 1,
            "maximum": 7
          }
        }
      }
    },
    "uncertainty_statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "I_com_kgm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "x_com_m": {
      "type": "number"
    },
    "position_unit": {
      "const": "m"
    }
  },
  "examples": [{
    "I_com_kgm2": "<I_com in kg m^2, a number>",
    "x_com_m": "<x_com in m, a number>",
    "unit": "kg m^2",
    "position_unit": "m",
    "model": "<the relation you used and how each submitted value follows from the cited evidence>",
    "measurements": [
      {"evidence_id": "<episode_id>:photogate:<n>", "load": "empty", "period_s": "<period in s, a number>", "used_in_fit": true, "hole": null},
      {"evidence_id": "<episode_id>:photogate:<n>", "load": "standard_disc", "period_s": "<period in s, a number>", "used_in_fit": true, "hole": null},
      {"evidence_id": "<episode_id>:photogate:<n>", "load": "unknown_object", "period_s": "<period in s, a number>", "used_in_fit": true, "hole": "<hole number, an integer>"},
      {"evidence_id": "<episode_id>:photogate:<n>", "load": "unknown_object", "period_s": "<period in s, a number>", "used_in_fit": true, "hole": "<hole number, an integer>"}
    ],
    "uncertainty_statement": "<your uncertainty estimate and its main contributions>"
  }]
}
