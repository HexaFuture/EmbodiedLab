{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "embodiedlab/experiments/spectro_basic/submission.json",
  "title": "spectro_basic submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concentration_uM",
    "readings",
    "model",
    "uncertainty_statement"
  ],
  "properties": {
    "concentration_uM": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "A",
          "c_from_stock_uM"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "evidence_id of the get_observation (this episode) whose images show this reading on the spectrophotometer screen"
          },
          "A": {
            "type": "number"
          },
          "c_from_stock_uM": {
            "type": "number",
            "minimum": 0
          },
          "unknown_dilution_factor": {
            "type": "number",
            "minimum": 1
          }
        }
      }
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "uncertainty_statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "examples": [{
    "concentration_uM": "<concentration in µM, a number>",
    "readings": [
      {"evidence_id": "<episode_id>:obs:<n>", "A": "<absorbance, a number>", "c_from_stock_uM": "<concentration from the stock in µM, a number>"},
      {"evidence_id": "<episode_id>:obs:<n>", "A": "<absorbance, a number>", "c_from_stock_uM": "<concentration from the stock in µM, a number>", "unknown_dilution_factor": "<dilution factor of the unknown, a number>"}
    ],
    "model": "<the relation you used and how each submitted value follows from the cited evidence>",
    "uncertainty_statement": "<your uncertainty estimate and its main contributions>"
  }]
}
