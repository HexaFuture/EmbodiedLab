{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "embodiedlab/experiments/titration_weak_acid/submission.json",
  "title": "titration_weak_acid submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "c_HA_M",
    "pKa",
    "records",
    "model",
    "uncertainty_statement"
  ],
  "properties": {
    "c_HA_M": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "pKa": {
      "type": "number",
      "minimum": 0,
      "maximum": 14
    },
    "khp_mass_g": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "rows"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sample_id",
                "pH",
                "V_mL"
              ],
              "properties": {
                "sample_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "pH": {
                  "type": "number"
                },
                "V_mL": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "uncertainty_statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "examples": [{
    "c_HA_M": "<c_HA in mol/L, a number>",
    "pKa": "<pKa, a number>",
    "records": [
      {"evidence_id": "<episode_id>:titration:<n>", "rows": [{"sample_id": "<sample number, an integer>", "pH": "<pH, a number>", "V_mL": "<volume in mL, a number>"}, {"sample_id": "<sample number, an integer>", "pH": "<pH, a number>", "V_mL": "<volume in mL, a number>"}]},
      {"evidence_id": "<episode_id>:titration:<n>", "rows": [{"sample_id": "<sample number, an integer>", "pH": "<pH, a number>", "V_mL": "<volume in mL, a number>"}, {"sample_id": "<sample number, an integer>", "pH": "<pH, a number>", "V_mL": "<volume in mL, a number>"}]}
    ],
    "model": "<the relation you used and how each submitted value follows from the cited evidence>",
    "uncertainty_statement": "<your uncertainty estimate and its main contributions>"
  }]
}
