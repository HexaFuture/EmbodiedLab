{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "embodiedlab/experiments/battery_emf/submission.json",
  "title": "battery_emf submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["E_V", "r_ohm", "measurements", "model", "uncertainty_statement"],
  "properties": {
    "E_V": {"type": "number", "exclusiveMinimum": 0},
    "r_ohm": {"type": "number", "exclusiveMinimum": 0},
    "measurements": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "readings", "used_in_fit"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "t0_s": {"type": "number", "minimum": 0},
          "t1_s": {"type": "number", "minimum": 0},
          "readings": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"enum": ["V1", "V2", "A", "CH1", "CH2"]},
            "additionalProperties": {"type": "number"}
          },
          "used_in_fit": {"type": "boolean"}
        }
      }
    },
    "model": {"type": "string", "minLength": 1, "maxLength": 4000},
    "uncertainty_statement": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "examples": [{
    "E_V": "<E in V, a number>",
    "r_ohm": "<r in ohm, a number>",
    "measurements": [
      {"evidence_id": "<episode_id>:obs:<n>", "readings": {"V1": "<reading in V, a number>", "A": "<reading in A, a number>"}, "used_in_fit": true},
      {"evidence_id": "<episode_id>:logger:<n>", "t0_s": "<window start in s, a number>", "t1_s": "<window end in s, a number>", "readings": {"CH1": "<reading in V, a number>"}, "used_in_fit": false}
    ],
    "model": "<the relation you used and how each submitted value follows from the cited readings>",
    "uncertainty_statement": "<your uncertainty estimate and its main contributions>"
  }]
}
