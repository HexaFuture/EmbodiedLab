{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "embodiedlab/experiments/hooke_dynamic_k/submission.json",
  "title": "hooke_dynamic_k submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["k_N_per_m", "unit", "model", "measurements", "uncertainty_statement"],
  "properties": {
    "k_N_per_m": {"type": "number", "exclusiveMinimum": 0},
    "unit": {"const": "N/m"},
    "model": {"type": "string", "minLength": 1, "maxLength": 4000},
    "measurements": {
      "type": "array", "minItems": 3, "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "load_kg", "period_s", "used_in_fit"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "load_kg": {"type": "number", "minimum": 0},
          "period_s": {"type": "number", "exclusiveMinimum": 0},
          "n_periods": {"type": "integer", "minimum": 1},
          "used_in_fit": {"type": "boolean"}
        }
      }
    },
    "uncertainty_statement": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "examples": [{
    "k_N_per_m": "<k in N/m, a number>",
    "unit": "N/m",
    "model": "<the relation you used and how each submitted value follows from the cited evidence>",
    "measurements": [
      {"evidence_id": "<episode_id>:encoder:<n>", "load_kg": "<load in kg, a number>", "period_s": "<period in s, a number>", "n_periods": "<number of periods, an integer>", "used_in_fit": true},
      {"evidence_id": "<episode_id>:encoder:<n>", "load_kg": "<load in kg, a number>", "period_s": "<period in s, a number>", "n_periods": "<number of periods, an integer>", "used_in_fit": true},
      {"evidence_id": "<episode_id>:encoder:<n>", "load_kg": "<load in kg, a number>", "period_s": "<period in s, a number>", "n_periods": "<number of periods, an integer>", "used_in_fit": true}
    ],
    "uncertainty_statement": "<your uncertainty estimate and its main contributions>"
  }]
}
