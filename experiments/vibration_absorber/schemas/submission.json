{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "embodiedlab/experiments/vibration_absorber/submission.json",
  "title": "vibration_absorber submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["peak_amplitude_mm", "peak_frequency_hz", "sweep_evidence", "peak_reading", "configuration"],
  "properties": {
    "peak_amplitude_mm": {"type": "number", "exclusiveMinimum": 0},
    "peak_frequency_hz": {"type": "number", "minimum": 0, "maximum": 100},
    "sweep_evidence": {"type": "string", "minLength": 1, "maxLength": 200},
    "peak_reading": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id"],
      "properties": {"evidence_id": {"type": "string", "minLength": 1, "maxLength": 200}}
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["mass_g", "length_mm", "valve"],
      "properties": {
        "mass_g": {"type": "number", "minimum": 0, "maximum": 100},
        "length_mm": {"type": "integer", "minimum": 30, "maximum": 80},
        "valve": {"type": "integer", "minimum": 0, "maximum": 9}
      }
    }
  },
  "examples": [{
    "peak_amplitude_mm": "<the PEAK the analyzer showed after your final sweep, in mm, a number>",
    "peak_frequency_hz": "<the frequency it showed with that peak, in Hz, a number>",
    "sweep_evidence": "<episode_id>:sweep:<n>",
    "peak_reading": {"evidence_id": "<episode_id>:obs:<n> (an observation whose analyzer screen shows that sweep's PEAK)"},
    "configuration": {"mass_g": "<total mass of the weights in the tray, g>", "length_mm": "<the blade length of the carrier's detent, mm>", "valve": "<the valve setting, 0-9>"}
  }]
}
