{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "embodiedlab/experiments/grating_wavelength/submission.json",
  "title": "grating_wavelength submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["lambda_nm", "measurements", "model", "uncertainty_statement"],
  "properties": {
    "lambda_nm": {"type": "number", "exclusiveMinimum": 0},
    "measurements": {
      "type": "array", "minItems": 1, "maxItems": 60,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "grating_mm", "screen_mm", "x_minus1_mm", "x_plus1_mm", "used_in_fit"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "grating_mm": {"type": "number"},
          "screen_mm": {"type": "number"},
          "x_minus1_mm": {"type": "number"},
          "x_plus1_mm": {"type": "number"},
          "used_in_fit": {"type": "boolean"}
        }
      }
    },
    "model": {"type": "string", "minLength": 1, "maxLength": 4000},
    "uncertainty_statement": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "examples": [{
    "lambda_nm": "<lambda in nm, a number>",
    "measurements": [
      {"evidence_id": "<episode_id>:obs:<n>", "grating_mm": "<grating position in mm, a number>", "screen_mm": "<screen position in mm, a number>", "x_minus1_mm": "<x of the −1 order in mm, a number>", "x_plus1_mm": "<x of the +1 order in mm, a number>", "used_in_fit": true},
      {"evidence_id": "<episode_id>:obs:<n>", "grating_mm": "<grating position in mm, a number>", "screen_mm": "<screen position in mm, a number>", "x_minus1_mm": "<x of the −1 order in mm, a number>", "x_plus1_mm": "<x of the +1 order in mm, a number>", "used_in_fit": false}
    ],
    "model": "<the relation you used and how each submitted value follows from the cited evidence>",
    "uncertainty_statement": "<your uncertainty estimate and its main contributions>"
  }]
}
